msgid "Freemius product ID"
msgstr "Identifiant Freemius du produit"

#: src/Admin/SettingsPage.php:152
msgid "Freemius dashboard, your product, Settings: the ID is shown at the top of the page."
msgstr "Tableau de bord Freemius, votre produit, Settings : l'identifiant est affiché en haut de la page."

#: src/Admin/SettingsPage.php:163
msgid "API token"
msgstr "Jeton API"

#: src/Admin/SettingsPage.php:164
msgid "Freemius dashboard, your product, Settings, \"API & Keys\" tab: copy the \"API Bearer Authorization Token\". Stored encrypted, never displayed again."
msgstr "Tableau de bord Freemius, votre produit, Settings, onglet « API & Keys » : copiez le « API Bearer Authorization Token ». Stocké chiffré, jamais réaffiché."

#: src/Admin/SettingsPage.php:170
msgid "Name"
msgstr "Nom"

#: src/Admin/SettingsPage.php:171
msgid "Shown in the Elementor widget. Filled in by the connection test, editable."
msgstr "Affiché dans le widget Elementor. Rempli par le test de connexion, modifiable."

#: src/Admin/SettingsPage.php:182
msgid "Slug"
msgstr "Slug"

#: src/Admin/SettingsPage.php:183
msgid "Identifier used by the shortcodes and the ACF field: lowercase letters, digits and dashes. Filled in by the connection test. Changing it breaks the pages that use the old slug."
msgstr "Identifiant utilisé par les shortcodes et le champ ACF : minuscules, chiffres et tirets. Rempli par le test de connexion. Le changer casse les pages qui utilisent l'ancien slug."

#: src/Admin/SettingsPage.php:213
msgid "Defined in wp-config.php"
msgstr "Défini dans wp-config.php"

#. translators: %s: PHP constant name
#: src/Admin/SettingsPage.php:216
#, php-format
msgid "The constant %s takes precedence over the saved token. Remove it from wp-config.php to manage the token here."
msgstr "La constante %s est prioritaire sur le jeton enregistré. Retirez-la de wp-config.php pour gérer le jeton ici."

#: src/Admin/SettingsPage.php:226
msgid "Paste the token"
msgstr "Collez le jeton"

#: src/Admin/SettingsPage.php:226
msgid "Leave empty to keep the saved token"
msgstr "Laissez vide pour conserver le jeton enregistré"

#. translators: %s: last four characters of the token
#: src/Admin/SettingsPage.php:234
#, php-format
msgid "Saved token ending with %s."
msgstr "Jeton enregistré, se terminant par %s."

#: src/Admin/SettingsPage.php:239
msgid "The saved token cannot be read any more (security keys changed): paste it again."
msgstr "Le jeton enregistré n'est plus lisible (clés de sécurité changées) : collez-le à nouveau."

#: src/Admin/SettingsPage.php:246
msgid "Delete the saved token"
msgstr "Supprimer le jeton enregistré"

#: src/Admin/SettingsPage.php:274
msgid "Active"
msgstr "Actives"

#: src/Admin/SettingsPage.php:277
msgid "Total"
msgstr "Total"

#: src/Admin/SettingsPage.php:280
msgid "Version"
msgstr "Version"

