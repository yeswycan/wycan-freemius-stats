#: src/Admin/SettingsPage.php:35
msgid "You are not allowed to access this page."
msgstr "Vous n'avez pas l'autorisation d'accéder à cette page."

#: src/Admin/SettingsPage.php:40
msgid "Shortcodes, Elementor widget and PHP function, ready to copy."
msgstr "Shortcodes, widget Elementor et fonction PHP, prêts à copier."

#: src/Admin/SettingsPage.php:43
msgid "Freemius products whose installations and versions are displayed on the site."
msgstr "Produits Freemius dont les installations et les versions sont affichées sur le site."

#: src/Admin/SettingsPage.php:60
msgid "Each product needs its Freemius ID and the API token of that product. The connection test checks both before saving and fills in the name and the slug."
msgstr "Chaque produit a besoin de son identifiant Freemius et du jeton API de ce produit. Le test de connexion vérifie les deux avant l'enregistrement et remplit le nom et le slug."

#: src/Admin/SettingsPage.php:64
msgid "Add a product"
msgstr "Ajouter un produit"

#: src/Admin/SettingsPage.php:71
msgid "No product yet. Add one, test the connection, then save."
msgstr "Aucun produit pour l'instant. Ajoutez-en un, testez la connexion, puis enregistrez."

#: src/Admin/SettingsPage.php:85
msgid "Save the products"
msgstr "Enregistrer les produits"

#: src/Admin/SettingsPage.php:114
msgid "ID"
msgstr "ID"

#: src/Admin/SettingsPage.php:121
msgid "Default product of the widgets"
msgstr "Produit par défaut des widgets"

#: src/Admin/SettingsPage.php:142
msgid "Test connection"
msgstr "Tester la connexion"

#: src/Admin/SettingsPage.php:143
msgid "Remove"
msgstr "Supprimer"

